# Example runtime configuration for vikunja-notification-bridge.
# Copy to .env and fill in. NEVER commit the populated file.

# Where the bridge listens
LISTEN_ADDR=:8080
# IANA time zone used to format reminder times
TZ=America/New_York

# ntfy
# The full publish URL (server + topic).
NTFY_URL=https://ntfy.example.com/vikunja
# Publish Bearer token for ntfy (create one under ntfy's access control)
NTFY_TOKEN=

# Vikunja
VIKUNJA_BASE_URL=https://todo.example.com
# New API token you created in Vikunja (Account → API Tokens, scopes:
# Tasks → Read one and Tasks → Update). The read scope is required because
# Vikunja's task update wipes every field absent from the body, so the done
# endpoint reads the task first and posts it back whole; without read_one
# every button press fails with 502.
VIKUNJA_TOKEN=
# Icon shown on Android notifications
VIKUNJA_ICON_URL=https://todo.example.com/images/icons/android-chrome-512x512.png

# Secrets, generate with: openssl rand -hex 32
# The secret in the path of the webhook URL you register in Vikunja.
REMINDER_SECRET=
# The callback path secret. Keep it different from REMINDER_SECRET!
DONE_SECRET=

# Base for the callback links
PUBLIC_BASE_URL=https://notifications.example.com

# Optional hardening
# If set, X-Vikunja-Signature (HMAC-SHA256 of the body) is verified so even the
# path secret being leaked isn't enough to spoof reminders.
# Set VIKUNJA_WEBHOOK_SECRET in the Vikunja webhook dialog to the same value.
VIKUNJA_WEBHOOK_SECRET=
